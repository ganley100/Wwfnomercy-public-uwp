<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for the Xbox One Dev Mode build (uwp/package.ps1 fills in @VERSION@ and @PUBLISHER@). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap">

  <Identity
    Name="NoMercyRecompiled"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>WWF No Mercy: Recompiled</DisplayName>
    <PublisherDisplayName>NoMercyRecompiled</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
    <!-- The app CRT (vcruntime140_app.dll / msvcp140_app.dll): install Microsoft.VCLibs.x64.14.00.appx with the MSIX. -->
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.30704.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="NoMercyRecompiled.exe" EntryPoint="NoMercyRecompiled.App">
      <uap:VisualElements
        DisplayName="WWF No Mercy: Recompiled"
        Description="WWF No Mercy, statically recompiled (N64Recomp + RT64)."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="No Mercy">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0E0F11" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- RetroAchievements (opt-in, WCW_RA). -->
    <Capability Name="internetClient" />
    <!-- librecomp's live recompiler (mods) writes and runs code at runtime. -->
    <Capability Name="codeGeneration" />
  </Capabilities>
</Package>
